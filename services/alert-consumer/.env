# Alert-Consumer environment variables
# WARNING: This file contains secrets. Do NOT commit to source control for production.
# Use a secrets manager (Vault / Kubernetes Secrets / GitHub Secrets) in production.

# PostgreSQL connection details
DB_HOST=postgresql.nii.svc
DB_PORT=5432
DB_NAME=incident_db
DB_USER=incident_db
DB_PASSWORD=changeme

# JDBC URL (constructed from the values above). If you need extra JDBC options
# you can append them here, e.g. ?sslmode=verify-full&applicationName=alert-consumer
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# JPA / Hibernate tuning
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Flyway
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# Optional JDBC hardening (SCRAM iteration cap). If you need to pass as a JDBC param,
# append to SPRING_DATASOURCE_URL, e.g. ?scramMaxIterations=100000
#JDBC_EXTRA_PARAMS=?preferQueryMode=extended&scramMaxIterations=100000

# Kafka (fallback / local dev). The app reads spring.cloud.stream.kafka.binder.brokers
# from environment if set; keep here for convenience when running locally.
KAFKA_BROKERS=kafka-cluster-kafka-bootstrap.nii.svc:9092
SPRING_CLOUD_STREAM_KAFKA_BINDER_BROKERS=${KAFKA_BROKERS}

# Application port (consumer default expected: 8082)
SERVER_PORT=8082

# Prometheus / Actuator settings (examples)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# Add any other runtime secrets below
# EXAMPLE: SENTRY_DSN=

